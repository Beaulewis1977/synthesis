        },
        {
          "stepId": "3-find-examples",
          "description": "Find code examples for Stripe checkout implementation in Flutter",
          "tool": "find_code_examples",
          "endpoint": "POST /api/search",
          "params": {
            "query": "stripe checkout flutter payment sheet integration",
            "collection_id": "3b035748-5817-4438-8acc-d974c88a6233",
            "feature_tags": ["payments"],
