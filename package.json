{
  "name": "synthesis-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous RAG system with Claude Agent SDK",
  "repository": {
    "type": "git",
    "url": "https://github.com/beaulewis1977/synthesis.git"
  },
  "author": "beaulewis1977",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.12.0"
  },
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "dev": "turbo run dev",
    "dev:all": "bash scripts/dev.sh",
    "dev:infra": "docker compose up -d synthesis-db synthesis-ollama synthesis-redis",
    "dev:migrate": "pnpm --filter @synthesis/db migrate",
    "dev:build": "pnpm --filter @synthesis/shared build && pnpm --filter @synthesis/db build",
    "dev:server": "pnpm --filter @synthesis/server dev",
    "dev:web": "pnpm --filter @synthesis/web dev",
    "dev:mcp": "pnpm --filter @synthesis/mcp dev",
    "dev:desktop": "pnpm --filter @synthesis/desktop dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "test:integration": "turbo run test:integration",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "type-check": "turbo run typecheck",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "docker:dev": "docker compose up -d synthesis-db synthesis-ollama synthesis-redis",
    "docker:all": "bash scripts/docker-all.sh",
    "docker:up": "docker compose --profile app up -d",
    "docker:down": "docker compose --profile app down",
    "docker:logs": "docker compose --profile app logs -f",
    "docker:stop": "bash scripts/docker-all.sh --stop",
    "verify:mcp": "bash scripts/verify-mcp-tools.sh",
    "validate:mcp-scenarios": "node apps/server/perf/mcp_scenario_runner.mjs --dry-run",
    "prepare": "[ -d .git ] && command -v husky >/dev/null && husky install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.3",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.7.5",
    "@vitest/coverage-v8": "^2.1.4",
    "tsx": "^4.19.1",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2",
    "vitest": "^2.1.4"
  },
  "workspaces": ["apps/*", "packages/*"],
  "dependencies": {
    "pg": "^8.12.0"
  }
}
