# =============================================================================
# SYNTHESIS RAG SYSTEM - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values.
# This is the primary .env file. All packages inherit from here.
# Do NOT duplicate these values in apps/server/.env or apps/web/.env
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE & CACHE
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/synthesis
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# API KEYS - AI PROVIDERS
# -----------------------------------------------------------------------------
# Anthropic (Required for chat, summarization, OCR)
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Google AI (Gemini models) - Optional
GOOGLE_API_KEY=

# OpenAI (embeddings, chat) - Optional
OPENAI_API_KEY=

# Voyage AI (code embeddings) - Optional
VOYAGE_API_KEY=

# Cohere (reranking) - Optional
COHERE_API_KEY=

# -----------------------------------------------------------------------------
# API KEYS - OTHER SERVICES
# -----------------------------------------------------------------------------
# Google Search API (for ingestion agent web search) - Optional
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Encryption key for API keys stored in database (32 bytes hex)
# Generate with: openssl rand -hex 32
API_KEY_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# LOCAL LLM (Ollama)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Note: Model selection is managed via UI at /settings/models

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=development
SERVER_PORT=3333
WEB_PORT=5173
STORAGE_PATH=./storage

# MCP Server
MCP_PORT=3334
MCP_MODE=stdio

# -----------------------------------------------------------------------------
# PERFORMANCE & CACHING
# -----------------------------------------------------------------------------
SEARCH_CACHE_TTL_SECONDS=1800
SEARCH_CACHE_MAX_ITEMS=500
EMBEDDING_CACHE_TTL_MS=900000
EMBEDDING_CACHE_MAX_ITEMS=1000
SEARCH_SNIPPET_LENGTH=320
SEARCH_PAGE_SIZE=10
RERANK_CACHE_TTL_SECONDS=300
RERANK_CACHE_MAX_ITEMS=500
RERANK_TEXT_LIMIT=200
RELATED_FILES_CACHE_TTL_SECONDS=1800
RELATED_FILES_CACHE_MAX_ITEMS=1000

# -----------------------------------------------------------------------------
# SEARCH CONFIGURATION
# -----------------------------------------------------------------------------
# Search mode: 'vector' (semantic only) or 'hybrid' (semantic + BM25)
SEARCH_MODE=hybrid
ENABLE_TRUST_SCORING=true
HYBRID_VECTOR_WEIGHT=0.7
HYBRID_BM25_WEIGHT=0.3
FTS_LANGUAGE=english

# -----------------------------------------------------------------------------
# MODEL SELECTION
# -----------------------------------------------------------------------------
# Model/provider selection is managed via the UI at /settings/models
# Do NOT set provider/model env vars here - they will override UI settings!
# The UI saves to the database, which is the source of truth for model config.

# -----------------------------------------------------------------------------
# SYNTHESIS & CONTRADICTION DETECTION
# -----------------------------------------------------------------------------
ENABLE_SYNTHESIS=true
ENABLE_CONTRADICTION_DETECTION=true
# Model selection for contradiction is in UI (/settings/models)
CONTRADICTION_MAX_PAIRS=6
CONTRADICTION_MIN_SIMILARITY=0.2
CONTRADICTION_MAX_SIMILARITY=0.7

# -----------------------------------------------------------------------------
# COST MONITORING
# -----------------------------------------------------------------------------
MONTHLY_BUDGET_USD=10
ENABLE_COST_ALERTS=true
# Auto-overrides when budget exceeded (managed by system, don't set manually):
# EMBEDDING_PROVIDER_OVERRIDE=ollama
# RERANKER_PROVIDER_OVERRIDE=bge
# DISABLE_CONTRADICTION_DETECTION=true

# -----------------------------------------------------------------------------
# CODE INTELLIGENCE
# -----------------------------------------------------------------------------
CODE_CHUNKING=true
PRESERVE_IMPORTS=true
TRACK_RELATIONSHIPS=true
CODE_MAX_CHUNK_LINES=100

# -----------------------------------------------------------------------------
# BACKEND PARSING & TECH STACK
# -----------------------------------------------------------------------------
BACKEND_PARSING=true
TECH_STACK_TAGS=true
REDIS_ANALYSIS=true

# -----------------------------------------------------------------------------
# VISION OCR
# -----------------------------------------------------------------------------
VISION_OCR_ENABLED=true
VISION_OCR_MAX_PAGES=50
# OCR model selection is in UI (/settings/models -> Vision OCR)

# -----------------------------------------------------------------------------
# TOKEN-AWARE CHUNKING
# -----------------------------------------------------------------------------
AUTO_SPLIT_CHUNKS=true
TOKEN_SAFETY_MARGIN=0.1
CHUNK_OVERLAP_SIZE=150

# =============================================================================
# GPT Phase 2: Knowledge Graph & Graph Expansion
# =============================================================================

# Enable graph building during document ingestion (creates knowledge graph nodes/edges)
# When enabled, the ingestion pipeline will extract entities (symbols, tables,
# endpoints, configs) and their relationships, storing them in the knowledge graph.
ENABLE_GRAPH_BUILDER=true

# Enable graph expansion during search (expands results using knowledge graph)
# When enabled, search will traverse the knowledge graph from result chunks
# to find related context (symbols, tables, endpoints, configs).
# This enriches search results with contextually related entities.
ENABLE_GRAPH_EXPANSION=true

# Maximum traversal depth for graph expansion (1-10, default: 3)
# Higher values find more distant relationships but take longer.
# Depth 1 = direct relationships only
# Depth 2 = includes relationships of relationships
# Depth 3+ = finds increasingly distant connections
GRAPH_MAX_DEPTH=3

# Maximum nodes to visit during graph expansion (1-100, default: 50)
# Limits the number of related entities returned per search result.
# Higher values provide more context but increase response size.
GRAPH_MAX_NODES=50
