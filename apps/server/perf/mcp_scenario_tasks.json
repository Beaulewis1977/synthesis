          }
        }
      ],
      "successCriteria": {
        "requiredTools": [
          "get_project_tech_stack",
          "get_feature_recipe",
          "find_code_examples",
          "search_mobile_docs"
        ],
        "minToolCalls": 4,
        "allStepsPassed": true
      }
    },
    {
