            "usage_tier": "example"
          },
          "expectations": {
            "minResults": 1,
            "requiredUsageTiers": ["example"],
            "expectedDocPatterns": ["stripe", "checkout", "flutter"]
          }
        },
        {
          "stepId": "4-search-backend-docs",
          "description": "Search for Stripe webhook handling documentation for Node.js backend",
          "tool": "search_mobile_docs",
          "endpoint": "POST /api/search",
          "params": {
            "query": "stripe webhooks node typescript backend payment events",
            "collection_id": "3b035748-5817-4438-8acc-d974c88a6233",
