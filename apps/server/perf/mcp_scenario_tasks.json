      "steps": [
        {
          "stepId": "1-get-tech-stack",
          "description": "Analyze the project's technology stack to understand the existing architecture",
          "tool": "get_project_tech_stack",
          "endpoint": "GET /api/tech-profiles/:collectionId",
          "params": {},
          "expectations": {
            "profileExists": true,
            "expectedFrameworks": ["flutter", "node"],
            "techStackFieldsPresent": ["primary_language", "primary_framework", "frameworks"]
          }
        },
        {
          "stepId": "2-get-recipe",
