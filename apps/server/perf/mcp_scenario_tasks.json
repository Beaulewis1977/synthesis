      ],
      "successCriteria": {
        "requiredTools": [
          "get_feature_recipe",
          "find_code_examples",
          "get_project_tech_stack",
          "search_mobile_docs"
        ],
        "minToolCalls": 4,
        "allStepsPassed": true
      }
    },
    {
      "id": "user-settings-trace",
      "description": "Trace and modify the persistence path for user settings in an existing repository. Tests the agent's ability to use graph context expansion and symbol search for code navigation.",
      "category": "maintenance",
      "collectionId": "3b035748-5817-4438-8acc-d974c88a6233",
      "steps": [
        {
          "stepId": "1-get-db-schema",
          "description": "Get the database schema to understand user_settings table structure",
          "tool": "get_db_schema",
          "endpoint": "GET /api/graph/schema/:collectionId",
          "params": {
            "tables": "user_settings,settings,preferences",
            "include_relationships": true
          },
          "expectations": {
            "schemaTablesPresent": ["user_settings"],
            "includeRelationships": true
          }
        },
        {
          "stepId": "2-expand-screen-context",
          "description": "Expand graph context starting from UserSettingsScreen to trace code flow",
          "tool": "graph_expand_context",
          "endpoint": "POST /api/graph/context",
          "params": {
            "collection_id": "3b035748-5817-4438-8acc-d974c88a6233",
            "query": "UserSettingsScreen",
            "max_depth": 3,
            "max_nodes": 50,
            "edge_types": ["calls", "imports", "depends_on", "persists_to"]
          },
          "expectations": {
            "minNodes": 1,
            "graphExpansionEnabled": true,
            "expectedNodeTypes": ["symbol", "chunk"],
            "expectedEdgeTypes": ["calls", "imports"]
          }
        },
        {
          "stepId": "3-find-symbol-usages",
          "description": "Find all usages of the saveUserSettings function across the codebase",
          "tool": "find_symbol_usages",
          "endpoint": "POST /api/graph/symbols",
          "params": {
            "collection_id": "3b035748-5817-4438-8acc-d974c88a6233",
            "symbol_name": "saveUserSettings",
            "include_definitions": true,
            "include_usages": true,
            "max_results": 20
          },
          "expectations": {
            "symbolFound": true,
            "includeDefinitions": true,
            "includeUsages": true,
            "symbolSearchEnabled": true
          }
        },
        {
          "stepId": "4-expand-repository-context",
          "description": "Expand graph context around UserSettingsRepository to find persistence layer",
          "tool": "graph_expand_context",
          "endpoint": "POST /api/graph/context",
          "params": {
            "collection_id": "3b035748-5817-4438-8acc-d974c88a6233",
            "query": "UserSettingsRepository",
            "max_depth": 2,
            "max_nodes": 30,
            "edge_types": ["calls", "defines", "persists_to", "configured_by"]
          },
          "expectations": {
            "minNodes": 1,
            "graphExpansionEnabled": true,
            "expectedNodeTypes": ["symbol", "chunk"],
            "expectedEdgeTypes": ["calls", "defines", "persists_to"]
          }
        }
      ],
      "successCriteria": {
        "requiredTools": ["get_db_schema", "graph_expand_context", "find_symbol_usages"],
        "minToolCalls": 4,
        "allStepsPassed": true
      }
    }
  ],
  "toolEndpointMapping": {
    "search_mobile_docs": {
      "method": "POST",
      "endpoint": "/api/search",
      "description": "Feature-aware mobile documentation search with framework and feature filtering"
    },
    "find_code_examples": {
      "method": "POST",
      "endpoint": "/api/search",
      "description": "Find code examples by filtering to usage_tier='example' and code chunks",
      "requiredParams": {
        "usage_tier": "example"
      }
    },
    "get_feature_recipe": {
      "method": "POST",
      "endpoint": "/api/search",
      "description": "Get curated recipe for a feature by filtering to usage_tier='recipe'",
      "requiredParams": {
        "usage_tier": "recipe"
      }
    },
    "search_rag": {
      "method": "POST",
      "endpoint": "/api/search",
      "description": "Generic RAG search without feature-aware filtering"
    },
    "get_project_tech_stack": {
      "method": "GET",
      "endpoint": "/api/tech-profiles/:collectionId",
      "description": "Get technology stack profile for a collection"
    },
    "graph_expand_context": {
      "method": "POST",
      "endpoint": "/api/graph/context",
      "description": "Expand context using knowledge graph from seed nodes or query"
    },
    "find_symbol_usages": {
      "method": "POST",
      "endpoint": "/api/graph/symbols",
      "description": "Find definitions and usages of a symbol across the codebase"
    },
    "get_db_schema": {
      "method": "GET",
      "endpoint": "/api/graph/schema/:collectionId",
      "description": "Extract database schema information from collection"
    }
  },
  "evaluationMetrics": {
    "toolCallAccuracy": "Percentage of correct tool calls (right tool for the task)",
    "toolCallCompleteness": "Percentage of required tools that were actually called",
    "resultRelevance": "Average relevance score of returned results (0-1)",
    "scenarioSuccessRate": "Percentage of scenarios where all success criteria passed",
    "averageToolCalls": "Average number of tool calls per scenario",
    "errorRate": "Percentage of tool calls that resulted in errors"
  }
}
