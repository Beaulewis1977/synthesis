{
  "$schema": "./mcp_scenario_tasks.schema.json",
  "version": "1.0",
  "description": "Scenario-based evaluation tasks for testing Phase 3 MCP tools. Each scenario simulates a real-world mobile SaaS development workflow that requires multiple tool calls to complete successfully.",
  "collectionId": "3b035748-5817-4438-8acc-d974c88a6233",
  "scenarios": [
    {
      "id": "flutter-supabase-auth",
      "description": "Build a minimal Flutter + Supabase authentication flow. Tests the agent's ability to find recipes, documentation, code examples, and database schema for implementing auth.",
      "category": "authentication",
      "collectionId": "3b035748-5817-4438-8acc-d974c88a6233",
      "steps": [
        {
          "stepId": "1-get-recipe",
          "description": "Get the recommended authentication recipe for Flutter with Supabase backend",
          "tool": "get_feature_recipe",
          "endpoint": "POST /api/search",
          "params": {
            "query": "authentication recipe flutter supabase",
            "collection_id": "3b035748-5817-4438-8acc-d974c88a6233",
            "feature_tags": ["auth"],
            "platform": "mobile",
            "usage_tier": "recipe"
          },
          "expectations": {
            "minResults": 1,
            "requiredUsageTiers": ["recipe"],
            "requiredFeatureTags": ["auth"],
            "expectedDocPatterns": ["supabase", "authentication", "flutter"]
          }
        },
        {
          "stepId": "2-search-docs",
          "description": "Search for official Supabase auth documentation for Flutter integration",
          "tool": "search_mobile_docs",
          "endpoint": "POST /api/search",
          "params": {
            "query": "supabase auth flutter sign in sign up email password",
            "collection_id": "3b035748-5817-4438-8acc-d974c88a6233",
            "feature_tags": ["auth"],
            "platform": "mobile"
          },
          "expectations": {
            "minResults": 1,
            "requiredFeatureTags": ["auth"],
            "expectedDocPatterns": ["supabase", "flutter", "auth"]
          }
        },
        {
          "stepId": "3-find-examples",
          "description": "Find working code examples for Supabase authentication in Flutter",
          "tool": "find_code_examples",
          "endpoint": "POST /api/search",
          "params": {
            "query": "auth supabase flutter login example code",
            "collection_id": "3b035748-5817-4438-8acc-d974c88a6233",
            "feature_tags": ["auth"],
            "platform": "mobile",
            "usage_tier": "example"
          },
          "expectations": {
            "minResults": 1,
            "requiredUsageTiers": ["example"],
            "expectedDocPatterns": ["supabase", "auth", "flutter"]
          }
        },
        {
          "stepId": "4-get-db-schema",
          "description": "Get the database schema for users table to understand auth data structure",
          "tool": "get_db_schema",
          "endpoint": "GET /api/graph/schema/:collectionId",
          "params": {
            "tables": "users,profiles,auth",
            "include_relationships": true
          },
          "expectations": {
            "schemaTablesPresent": ["users"],
            "includeRelationships": true
          }
        }
      ],
      "successCriteria": {
        "requiredTools": [
          "get_feature_recipe",
          "find_code_examples",
          "search_mobile_docs",
          "get_db_schema"
        ],
        "minToolCalls": 4,
        "allStepsPassed": true
      }
    },
    {
      "id": "flutter-stripe-billing",
